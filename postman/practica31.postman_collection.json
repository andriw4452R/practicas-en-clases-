{
  "info": {
    "name": "Práctica 3.1 - Generación de reportes clínicos y financieros",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Publicar mensaje válido 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tipo_reporte\": \"clinico\", \"anio\": 2026}"
        },
        "url": "http://127.0.0.1:8001/api/p31/reportes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 202\", function () { pm.response.to.have.status(202); });",
              "let r = pm.response.json();",
              "pm.collectionVariables.set(\"correlation_id\", r.correlation_id);",
              "pm.collectionVariables.set(\"message_id\", r.message_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Publicar mensaje válido 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tipo_reporte\": \"financiero\", \"anio\": 2026}"
        },
        "url": "http://127.0.0.1:8001/api/p31/reportes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 202\", function () { pm.response.to.have.status(202); });",
              "let r = pm.response.json();",
              "pm.collectionVariables.set(\"correlation_id\", r.correlation_id);",
              "pm.collectionVariables.set(\"message_id\", r.message_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Publicar mensaje válido 3",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tipo_reporte\": \"clinico\", \"anio\": 2025}"
        },
        "url": "http://127.0.0.1:8001/api/p31/reportes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 202\", function () { pm.response.to.have.status(202); });",
              "let r = pm.response.json();",
              "pm.collectionVariables.set(\"correlation_id\", r.correlation_id);",
              "pm.collectionVariables.set(\"message_id\", r.message_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Consultar correlación",
      "request": {
        "method": "GET",
        "url": "http://127.0.0.1:8001/api/p31/reportes/{{correlation_id}}"
      }
    },
    {
      "name": "05 - Solicitud inválida HTTP 422",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tipo_reporte\": \"inventado\", \"anio\": 2010}"
        },
        "url": "http://127.0.0.1:8001/api/p31/reportes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Versión síncrona",
      "request": {
        "method": "POST",
        "header": [
