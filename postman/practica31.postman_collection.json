        },
        "url": "http://127.0.0.1:8001/api/p31/reportes/sincrono"
      }
    }
  ],
  "variable": [
    {
      "key": "correlation_id",
      "value": ""
    },
    {
      "key": "message_id",
      "value": ""
    }
  ]
